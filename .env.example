# Public local/preview browser configuration. These values are not authorization authority.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only application configuration. Never use a service-role key in browser code.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
APP_BASE_URL=http://127.0.0.1:3000
LEGACY_GAME_URL=http://127.0.0.1:4173/docs/index.html

# Phase 2A billing contract. Keep BILLING_ENABLED=false until Phase 2B is
# separately approved. Values below are names/placeholders only; never commit
# provider credentials. Local/test/preview accept test mode only.
BILLING_ENABLED=false
BILLING_ENVIRONMENT=local
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=replace-with-test-publishable-key
STRIPE_SECRET_KEY=replace-with-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-local-endpoint-secret
STRIPE_PRODUCT_TEACHER_PRO=replace-with-test-product-id
STRIPE_PRICE_TEACHER_PRO_MONTHLY=replace-with-test-monthly-price-id
STRIPE_PRICE_TEACHER_PRO_ANNUAL=replace-with-test-annual-price-id
BILLING_APP_BASE_URL=http://127.0.0.1:3000
# Production additionally requires this exact value after explicit approval:
# BILLING_LIVE_ACTIVATION=owner-approved
