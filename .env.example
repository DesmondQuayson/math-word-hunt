# MVH_APPLICATION_ORIGIN=https://mathnexa.com
# BILLING_APP_BASE_URL=https://mathnexa.com
# MVH_SUBSCRIBER_MANAGEMENT_ORIGIN=https://replace-with-stable-production-alias.vercel.app
