# Public local/preview browser configuration. These values are not authorization authority.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only application configuration. Never use a service-role key in browser code.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Server-only secret used by billing reconciliation. Never expose to the browser.
SUPABASE_SECRET_KEY=replace-with-local-secret-key
APP_BASE_URL=http://127.0.0.1:3000
LEGACY_GAME_URL=http://127.0.0.1:4173/docs/index.html

# Phase 4 server-owned environment registry. Do not create NEXT_PUBLIC aliases.
# Production is intentionally rejected during Phase 4.
MVH_APP_ENVIRONMENT=local
MVH_APPLICATION_ORIGIN=http://127.0.0.1:3000
MVH_SUPABASE_PROJECT_REF=local-supabase
MVH_STRIPE_MODE=disabled
MVH_EMAIL_DELIVERY=local-capture
MVH_MONITORING_MODE=console
MVH_FIXTURE_POLICY=allowed
MVH_DELETION_MODE=dry-run
MVH_BUILD_ID=local-unversioned

# Phase 8A Super Admin security shell. Disabled by default. Never create a
# NEXT_PUBLIC alias for these values or commit a real CSRF secret.
MVH_ADMIN_ENABLED=false
# MVH_ADMIN_CSRF_SECRET=replace-with-managed-server-secret-of-at-least-32-characters
# MVH_ADMIN_SESSION_MINUTES=15
# Server-only HMAC key for five-minute, package-scoped game asset capabilities.
# MVH_GAME_DELIVERY_SECRET=replace-with-separate-managed-secret-of-at-least-32-characters
# Server-only shared HS256 key for protected Number Cross launch assertions.
# The exact same managed value must exist in the Number Cross Vercel project.
# Never add a NEXT_PUBLIC alias or commit a real value.
# MATHNEXA_GAME_LAUNCH_SECRET=replace-with-shared-managed-secret-of-at-least-32-bytes
# Emergency hosted CLI only; set externally for a reviewed incident operation.
# MVH_ADMIN_REVOCATION_APPROVAL=not-approved

# Phase 7B local Production-platform rehearsal. These placeholders document
# the contract only; do not activate them on Vercel or copy Preview credentials.
# An isolated project must use consumer-v1. Phase 7C permits Stripe Sandbox only.
# MVH_APP_ENVIRONMENT=production-platform
# MVH_APPLICATION_ORIGIN=http://127.0.0.1:3000
# MVH_ALLOW_LOCAL_PRODUCTION_REHEARSAL=true
# MVH_IDENTITY_MODEL=consumer-v1
# MVH_SUPABASE_PROJECT_REF=production-local
# MVH_PRODUCTION_SUPABASE_PROJECT_REF=production-local
# MVH_PREVIEW_SUPABASE_PROJECT_REF=preview-local
# MVH_PREVIEW_SUPABASE_URL=https://preview-project.supabase.co
# MVH_PREVIEW_SUPABASE_PUBLISHABLE_KEY=replace-with-distinct-preview-public-key
# MVH_PREVIEW_SUPABASE_SECRET_KEY=replace-with-distinct-preview-secret-key
# MVH_STRIPE_MODE=disabled
# MVH_EMAIL_DELIVERY=local-capture
# MVH_FIXTURE_POLICY=forbidden
# MVH_DELETION_MODE=dry-run
# MVH_PILOT_STATE=inactive
# MVH_INVITATIONS_ENABLED=false
# BILLING_ENABLED=false
# BILLING_CHECKOUT_ENABLED=false
# BILLING_PORTAL_ENABLED=false
# BILLING_WEBHOOK_ENABLED=false

# Phase 7C Stripe Sandbox consumer subscription. Never use live keys here.
# Setup-mode Checkout collects a payment method before the server creates the
# one-time 24-hour trial and $5.99 monthly subscription.
# MVH_STRIPE_MODE=test
# BILLING_ENABLED=true
# BILLING_ENVIRONMENT=production-platform
# BILLING_PROVIDER=stripe
# STRIPE_MODE=test
# STRIPE_API_VERSION=2026-07-29.dahlia
# STRIPE_PUBLISHABLE_KEY=replace-with-secure-local-sandbox-publishable-key
# STRIPE_SECRET_KEY=replace-with-secure-local-sandbox-secret-key
# STRIPE_WEBHOOK_SECRET=replace-with-secure-local-sandbox-webhook-secret
# STRIPE_PRODUCT_MATHNEXA=replace-with-sandbox-product-id
# STRIPE_PRICE_MATHNEXA_MONTHLY=replace-with-sandbox-monthly-price-id
# STRIPE_PORTAL_CONFIGURATION_ID=replace-with-sandbox-portal-configuration-id
# BILLING_APP_BASE_URL=http://127.0.0.1:3000
# BILLING_CHECKOUT_ENABLED=true
# BILLING_PORTAL_ENABLED=true
# BILLING_WEBHOOK_ENABLED=true
# BILLING_EMERGENCY_DEFAULT_DENY=false

