# Public local/preview browser configuration. These values are not authorization authority.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only application configuration. Never use a service-role key in browser code.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Server-only secret used by billing reconciliation. Never expose to the browser.
SUPABASE_SECRET_KEY=replace-with-local-secret-key
APP_BASE_URL=http://127.0.0.1:3000
LEGACY_GAME_URL=http://127.0.0.1:4173/docs/index.html

# Phase 4 server-owned environment registry. Do not create NEXT_PUBLIC aliases.
# Production is intentionally rejected during Phase 4.
MVH_APP_ENVIRONMENT=local
MVH_APPLICATION_ORIGIN=http://127.0.0.1:3000
MVH_SUPABASE_PROJECT_REF=local-supabase
MVH_STRIPE_MODE=disabled
MVH_EMAIL_DELIVERY=local-capture
MVH_MONITORING_MODE=console
MVH_FIXTURE_POLICY=allowed
MVH_DELETION_MODE=dry-run
MVH_BUILD_ID=local-unversioned

# Phase 6B controlled-pilot contract. Every value is server-only. Missing,
# malformed, browser-public, Production, or incomplete configuration denies activation.
MVH_PILOT_STATE=inactive
MVH_PILOT_START_AT=
MVH_PILOT_END_AT=
MVH_PILOT_OWNER_GO=incomplete
MVH_PILOT_DATES_APPROVED=incomplete
MVH_PILOT_SUPPORT_CHANNEL=incomplete
MVH_PILOT_AUTH_EMAIL_VERIFIED=incomplete
MVH_PILOT_CONFIRMATION_FLOW=incomplete
MVH_PILOT_RECOVERY_FLOW=incomplete
MVH_PILOT_HUMAN_ACCESS=incomplete
MVH_PILOT_PRIVACY_POLICY=incomplete
MVH_PILOT_INCIDENT_OPERATOR=incomplete
MVH_PILOT_ROLLBACK_OPERATOR=incomplete

# Phase 2 test-mode billing contract. Keep disabled unless deliberately running
# the local sandbox flow. Values below are placeholders only; never commit
# provider credentials. Local/test/preview accept test mode only.
BILLING_ENABLED=false
BILLING_ENVIRONMENT=local
BILLING_PROVIDER=stripe
STRIPE_MODE=test
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_PUBLISHABLE_KEY=replace-with-test-publishable-key
STRIPE_SECRET_KEY=replace-with-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-local-endpoint-secret
STRIPE_PRODUCT_TEACHER_PRO=replace-with-test-product-id
STRIPE_PRICE_TEACHER_PRO_MONTHLY=replace-with-test-monthly-price-id
STRIPE_PRICE_TEACHER_PRO_ANNUAL=replace-with-test-annual-price-id
STRIPE_PORTAL_CONFIGURATION_ID=replace-with-test-portal-configuration-id
BILLING_APP_BASE_URL=http://127.0.0.1:3000
BILLING_CHECKOUT_ENABLED=false
BILLING_PORTAL_ENABLED=false
BILLING_WEBHOOK_ENABLED=false
BILLING_EMERGENCY_DEFAULT_DENY=true
# Production additionally requires this exact value after explicit approval:
# BILLING_LIVE_ACTIVATION=owner-approved

# Phase 5 hosted-preview approval gates. Defaults are deliberately non-mutating.
# Do not change these until the owner separately approves the proposed resource
# creation and read-only hosted validation described in the Phase 5 runbook.
PHASE5_HOSTED_APPROVAL=not-approved
PHASE5_HOSTED_CHECKS_ENABLED=false
PHASE5_HOSTED_READ_ONLY_APPROVAL=not-approved
PHASE5_EXTERNAL_MUTATIONS=false
PHASE5_PREVIEW_CLASSIFICATION=unconfigured
MVH_PREVIEW_URL=https://preview.example.invalid
# Owner-controlled automation secret. Never commit its value. It is only read
# by the hosted Playwright runner after all approval gates pass.
VERCEL_AUTOMATION_BYPASS_SECRET=replace-with-owner-controlled-preview-secret
