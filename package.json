{
  "name": "math-vocabulary-hunt",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "serve": "node scripts/serve-static.mjs",
    "dev:platform": "node scripts/run-platform-dev.mjs",
    "build": "npm run build --workspace @math-vocabulary-hunt/platform-web",
    "lint": "eslint . && npm run lint --workspace @math-vocabulary-hunt/platform-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:content": "node scripts/audit-content.mjs",
    "test:unit": "npm run test --workspace @math-vocabulary-hunt/platform-core && npm run test --workspace @math-vocabulary-hunt/platform-web",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:canonical": "node scripts/run-e2e.mjs e2e/math-word-hunt-v7.spec.mjs",
    "test:e2e:platform": "node scripts/run-platform-e2e.mjs",
    "test:e2e:platform:prototype": "node scripts/run-platform-e2e.mjs --prototype teacher-prototype.spec.ts",
    "test:e2e:scenarios": "node scripts/run-platform-e2e.mjs teacher-scenarios.spec.ts",
    "test:e2e:visual": "node scripts/run-platform-e2e.mjs visual-regression.spec.ts",
    "test:e2e:phase1d": "node scripts/run-phase1d-e2e.mjs",
    "test:e2e:phase2": "node scripts/run-phase2-e2e.mjs",
    "test:e2e:phase3": "node scripts/run-phase3-e2e.mjs",
    "test:production-default": "npm run build && node scripts/audit-production-default.mjs",
    "test:security": "node scripts/audit-platform-bundle.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --local",
    "supabase:test": "supabase test db",
    "db:reset": "npm run supabase:reset",
    "db:test": "npm run supabase:test",
    "db:verify": "npm run supabase:status && npm run db:test",
    "phase1d:verify": "node scripts/verify-phase1d.mjs",
    "test:billing": "npm run test --workspace @math-vocabulary-hunt/platform-core -- src/billing && npm run test --workspace @math-vocabulary-hunt/platform-web -- lib/billing",
    "test:billing:security": "node scripts/audit-billing-security.mjs",
    "test:capabilities": "npm run test --workspace @math-vocabulary-hunt/platform-core -- src/capabilities && npm run test --workspace @math-vocabulary-hunt/platform-web -- lib/capabilities lib/repositories/capability.repository.test.ts",
    "test:capabilities:security": "node scripts/audit-capability-security.mjs",
    "phase2a:verify": "node scripts/verify-phase2a.mjs",
    "phase2:verify": "node scripts/verify-phase2.mjs",
    "phase3:verify": "node scripts/verify-phase3.mjs",
    "billing:provision:test": "node scripts/provision-stripe-test.mjs",
    "billing:reconcile": "node scripts/billing-ops.mjs",
    "billing:replay": "node scripts/billing-ops.mjs",
    "test": "npm run test:content && npm run test:unit && npm run test:e2e && npm run test:e2e:platform"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "eslint": "9.39.5",
    "globals": "latest",
    "supabase": "2.109.1",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
